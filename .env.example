# ── AyNesil Platform Environment Variables ──────────────────────────────────
# Copy to .env and fill in real values before running.
# NEVER commit .env to source control.
#
# docker-compose.yml bu dosyayı iki yoldan okur:
#   1) ${...} yer tutucuları (DB, Redis, portlar)
#   2) API servisinin env_file'ı: buraya yazılan HER AYNESIL_ değişkeni API'ye ulaşır
#      (ForwardedHeaders, CORS, token süreleri, log seviyesi…). Override dosyası gerekmez.

# ── Yerel geliştirme (yalnızca geliştirici makinesi) ─────────────────────────
# PostgreSQL/Redis/API portlarını ana makineye açan eki her docker compose komutuna ekler
# (dotnet run, DB istemcisi). Üretimde YAZMAYIN: portlar dışarı açılır.
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=aynesil
POSTGRES_USER=aynesil_owner
POSTGRES_PASSWORD=changeme_owner
AYNESIL_DB_APP_USER=aynesil_app
AYNESIL_DB_APP_PASSWORD=changeme_app

# API'nin bağlantı dizeleri compose dosyasında yukarıdaki değerlerden kurulur; buraya yazmayın.

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis şifresi (redis-server --requirepass; API bağlantısı compose'da buna göre kurulur).
# Yalnızca harf ve rakam kullanın (bağlantı dizesinde virgül/eşittir ayırıcıdır): openssl rand -hex 24
AYNESIL_REDIS_PASSWORD=changeme_redis

# ── JWT ──────────────────────────────────────────────────────────────────────
# IMPORTANT: Use at least 64 random characters in production!
AYNESIL_Jwt__Secret=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
AYNESIL_Jwt__Issuer=https://api.aynesil.com
AYNESIL_Jwt__Audience=aynesil-web
AYNESIL_Jwt__AccessTokenExpiryMinutes=60
AYNESIL_Jwt__RefreshTokenExpiryDays=30

# ── CORS ─────────────────────────────────────────────────────────────────────
# Ön yüz API'yi aynı adresten (/api) çağırdığı için normalde gerekmez; canlıda kendi adresinizi yazın.
AYNESIL_Cors__AllowedOrigins__0=http://localhost:5173
# AYNESIL_Cors__AllowedOrigins__1=https://app.ornek.com

# ── Ağ ve gerçek istemci IP'si ───────────────────────────────────────────────
# Compose iç ağı. API ve ön yüz nginx'i X-Forwarded-For'u yalnızca bu ağdan kabul eder; sunucudaki ters
# vekil Docker ağ geçidi üzerinden bu ağdan bağlanır. Sunucuda başka bir ağla çakışırsa değiştirin.
AYNESIL_NETWORK_SUBNET=172.30.0.0/24
# Ters vekil başka bir makinedeyse/ağdaysa ek güvenilir vekil:
# AYNESIL_ForwardedHeaders__KnownProxies__0=10.0.0.5
# AYNESIL_ForwardedHeaders__KnownNetworks__1=10.0.0.0/24

# ── Storage ──────────────────────────────────────────────────────────────────
AYNESIL_Storage__Local__RootPath=/app/uploads
AYNESIL_Storage__Local__BaseUrl=http://localhost:5000/files

# ── Serilog ──────────────────────────────────────────────────────────────────
AYNESIL_Serilog__MinimumLevel__Default=Information

# ── Portlar ──────────────────────────────────────────────────────────────────
# API ve ön yüz yalnızca 127.0.0.1'e yayınlanır (dışarıya ters vekil açılır).
API_PORT=5000
FRONTEND_PORT=5173
# Ters vekilsiz, ön yüzü doğrudan dışarı açmak için (önerilmez: TLS yok): FRONTEND_BIND=0.0.0.0
FRONTEND_BIND=127.0.0.1
